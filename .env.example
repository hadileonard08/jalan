DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flight_tracker"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"
GEMINI_API_KEY="your_gemini_api_key"
# Optional: override the default chat model. For Gemini try gemini-3.5-flash-lite or gemini-3.5-flash.
# For OpenAI set OPENAI_API_KEY and use gpt-4o-mini, gpt-4o, etc.
OPENAI_API_KEY="your_openai_api_key"
# Optional: Pexels API key for additional image sources (free, 200 req/hour).
# Leave empty or set to your_pexels_api_key to use only Wikimedia/Wikipedia/Openverse.
PEXELS_API_KEY="your_pexels_api_key"

# Optional: CLIP image search microservice (internal, not exposed to public).
# Set this to enable semantic vector image search in the itinerary builder.
# e.g. http://127.0.0.1:8000 for local Docker, or https://image-search.yourdomain.com in production.
IMAGE_SEARCH_SERVICE_URL="http://127.0.0.1:8000"
# Minimum cosine similarity score (0-1) to accept a vector search result.
VECTOR_IMAGE_MIN_SCORE=0.15
CHAT_MODEL="gemini-flash-lite-latest"
SEATS_AERO_API_KEY="your_seats_aero_api_key"
TRAVELPAYOUTS_API_TOKEN="your_travelpayouts_api_token"
TRAVELPAYOUTS_MARKER="your_travelpayouts_marker"
TRAVELPAYOUTS_HOST="your-domain.com"
DUFFEL_API_TOKEN="your_duffel_api_token"
AVIATIONSTACK_API_KEY="your_aviationstack_api_key"
RESEND_API_KEY="your_resend_api_key"
FROM_EMAIL="Flight Deals <hello@yourdomain.com>"
NOTIFICATION_EMAIL="you@example.com"
MAINTENANCE_MODE=false
CARTO_API_KEY=
NEXT_PUBLIC_CARTO_API_KEY=
